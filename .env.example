# Clé API Anthropic : analyses à la demande et prédictions IA en continu (https://console.anthropic.com).
ANTHROPIC_API_KEY=
# Clé Financial Modeling Prep : fiches entreprises (bilans, ratios, résultats). https://site.financialmodelingprep.com
FMP_API_KEY=
# Nombre maximum d'analyses à la demande par heure et par visiteur.
AI_LIMIT_PER_HOUR=10
# Prédictions IA : actifs suivis (symboles Yahoo séparés par des virgules), fréquence et âge maximum avant recalcul.
# PRED_SYMBOLS=^FCHI,^GSPC,BTC-USD
PRED_INTERVAL_MIN=60
PRED_MAX_AGE_H=6
# Niveau de réflexion des prédictions (low, medium, high) et modèle (par défaut claude-opus-5-5).
PRED_EFFORT=low
# PRED_MODEL=
# Jeton secret pour relancer les prédictions à la main (POST /api/predictions/run, en-tête x-admin-token).
ADMIN_TOKEN=
# Dossier où sont gardées les prédictions et leur historique.
DATA_DIR=data
# 1 = données fictives, pour développer sans connexion aux marchés.
MOCK=0
